# Application Environment
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BASE_URL=http://localhost:3001
FRONTEND_DEV_BIND=0.0.0.0
FRONTEND_DEV_PORT=3001
FRONTEND_PROD_PORT=3002

# Map Tile Proxy & Cache Configuration
# Upstream OSM tile URL template
TILE_UPSTREAM_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# OSM policy requirement: descriptive User-Agent with contact email / website
TILE_USER_AGENT=MelktodayTileProxy/2.0 (+https://melktoday.com; contact@melktoday.com)

# Persistent disk cache directory (mounted volume in production)
TILE_CACHE_DIR=.tile-cache

# Cache expiration in days (fresh tiles served directly, stale revalidated in background)
TILE_TTL_DAYS=30

# Maximum disk cache size in gigabytes before LRU eviction runs
TILE_CACHE_MAX_GB=5

# Maximum allowed zoom level for client requests (OSM policy constraint)
TILE_MAX_ZOOM=17

# Maximum concurrent requests to upstream OSM tile servers
TILE_UPSTREAM_CONCURRENCY=6

# In-memory LRU cache maximum size in megabytes for hot tiles
TILE_MEM_CACHE_MAX_MB=64
