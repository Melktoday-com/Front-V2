NODE_ENV=production
NEXT_PUBLIC_API_URL=https://melktoday.com/backend/api
NEXT_PUBLIC_BASE_URL=https://melktoday.com
FRONTEND_PROD_PORT=3002

# Map Tile Proxy & Cache Configuration
TILE_UPSTREAM_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_USER_AGENT=MelktodayTileProxy/2.0 (+https://melktoday.com; contact@melktoday.com)
TILE_CACHE_DIR=/app/.cache/tiles
TILE_TTL_DAYS=30
TILE_CACHE_MAX_GB=5
TILE_MAX_ZOOM=17
TILE_UPSTREAM_CONCURRENCY=6
TILE_MEM_CACHE_MAX_MB=64

